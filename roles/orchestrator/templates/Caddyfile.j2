{% for _mh in (_media_hosts | default([])) %}

http://{{ _mh.hostname }} {
{# MultimediaViewer requests with crossOrigin="anonymous" and fails without
   this. Must be constant, not reflected: a CDN caches the response. #}
    header Access-Control-Allow-Origin "*"

    reverse_proxy https://{{ _mh.bucket }}.{{ _mh.endpoint }} {
{# Object storage selects the bucket from the Host header, not the path;
   without this rewrite it returns NoSuchBucket. #}
        header_up Host {{ _mh.bucket }}.{{ _mh.endpoint }}
{# Never forward the wiki session cookie or Authorization to the provider. #}
        header_up -Cookie
        header_up -Authorization
        transport http {
            tls
{# SNI must match the provider, not the public hostname. #}
            tls_server_name {{ _mh.bucket }}.{{ _mh.endpoint }}
        }
    }

    log {
        output file /var/log/caddy/media.log
    }
}
