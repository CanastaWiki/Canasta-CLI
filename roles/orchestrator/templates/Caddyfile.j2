# Auto-generated by Canasta — DO NOT EDIT (edit Caddyfile.global / Caddyfile.site).
{#
  Structure (see rewrite_caddy.yml):
  - CLI-managed global directives (trusted_proxies / crowdsec) go in
    the leading global options block below.
  - The user's Caddyfile.global is inlined verbatim after it; rewrite_caddy.yml
    melds all global options blocks into one (Caddy permits exactly one) via the
    meld_caddy_global_blocks filter, leaving any site blocks in place.
  - Caddyfile.site is imported live inside the site block.
#}
{
    servers {
        client_ip_headers X-Forwarded-For
        trusted_proxies static {{ _trusted_proxies_cidrs | join(' ') }}
        trusted_proxies_strict
    }
{% if _crowdsec_active | default(false) %}
    order crowdsec first
    crowdsec {
        api_url http://crowdsec:8080
        api_key {env.CROWDSEC_BOUNCER_API_KEY}
        ticker_interval 15s
    }
{% endif %}
}

{{ _caddyfile_global_content | default('') }}
{{ _site_address }} {
    import /etc/caddy/Caddyfile.site

{# Varnish admits PURGE from private addresses, which includes Caddy.
   MediaWiki purges Varnish directly, so no PURGE needs to pass here. #}
    @purge method PURGE
    handle @purge {
        respond 405
    }
{% for _sm in _sitemap_rewrites | default([]) %}

    @sitemap{{ loop.index }} {
        host {{ _sm.host }}
        path {{ _sm.path }}/*
    }
    uri @sitemap{{ loop.index }} path_regexp {{ _sm.pattern }} {{ _sm.target }}/
{% endfor %}

{% if _crowdsec_active | default(false) %}
    crowdsec
{% endif %}
{#
  reverse_proxy appends its immediate peer to X-Forwarded-For, which behind a
  CDN is the edge address, and trusted_proxies only changes who Caddy considers
  the client for itself. header_up runs after that automatic handling, so it
  must sit inside the proxy block to replace the value rather than precede it.
#}
{% if _observable %}
    @opensearch path /opensearch /opensearch/*
    handle @opensearch {
        basicauth {
            {{ _os_user }} {{ _os_password_hash }}
        }
        reverse_proxy opensearch-dashboards:5601
    }

    handle {
        reverse_proxy {{ _backend }} {
            header_up X-Forwarded-For {client_ip}
        }
    }
{% else %}
    reverse_proxy {{ _backend }} {
        header_up X-Forwarded-For {client_ip}
    }
{% endif %}

    log {
        output file /var/log/caddy/access.log
    }
}

{% for _mh in (_media_hosts | default([])) %}

http://{{ _mh.hostname }} {
{# MultimediaViewer requests with crossOrigin="anonymous" and fails without
   this. Must be constant, not reflected: a CDN caches the response. #}
    header Access-Control-Allow-Origin "*"

    reverse_proxy https://{{ _mh.bucket }}.{{ _mh.endpoint }} {
{# Object storage selects the bucket from the Host header, not the path;
   without this rewrite it returns NoSuchBucket. #}
        header_up Host {{ _mh.bucket }}.{{ _mh.endpoint }}
{# Never forward the wiki session cookie or Authorization to the provider. #}
        header_up -Cookie
        header_up -Authorization
        transport http {
            tls
{# SNI must match the provider, not the public hostname. #}
            tls_server_name {{ _mh.bucket }}.{{ _mh.endpoint }}
        }
    }

    log {
        output file /var/log/caddy/media.log
    }
}
{% endfor %}
